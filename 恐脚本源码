function kbInvCheckRestore()
    if kbSoulOn or kbInv1On or kbInv2On then return end
    local fake = kbInvFakeChar
    local real = kbInvRealChar
    local backCF = nil
    if fake and fake.Parent then
        local h = fake:FindFirstChild("HumanoidRootPart")
        if h then backCF = h.CFrame end
    end
    if kbInvRespawnConn then
        pcall(function() kbInvRespawnConn:Disconnect() end)
        kbInvRespawnConn = nil
    end
    kbInvResetTrans()
    pcall(function() if fake then fake:Destroy() end end)
    kbInvFakeChar = nil
    kbInvRealChar = nil
    if kbInvOldFPDH then
        pcall(function() workspace.FallenPartsDestroyHeight = kbInvOldFPDH end)
        kbInvOldFPDH = nil
    end
    if real and real.Parent ~= nil then
        pcall(function() real.Parent = workspace end)
        LocalPlayer.Character = real
        if backCF then
            pcall(function() real:MoveTo(backCF.Position) end)
        end
        local hum = real:FindFirstChildOfClass("Humanoid")
        if hum then workspace.CurrentCamera.CameraSubject = hum end
    end
end
