local function resetImpersonate()
    if impersonateHeartbeat then
        impersonateHeartbeat:Disconnect()
        impersonateHeartbeat = nil
    end
    if activeImpersonateClone then
        activeImpersonateClone:Destroy()
        activeImpersonateClone = nil
    end
    local realChar = impersonateRealChar
    if realChar and realChar.Parent then
        LocalPlayer.Character = realChar
        local rh = realChar:FindFirstChildOfClass("Humanoid")
        if rh then rh.PlatformStand = false end
        Camera.CameraSubject = rh
        for _, v in ipairs(realChar:GetDescendants()) do
            if v:IsA("BasePart") or v:IsA("Decal") then v.Transparency = 0 end
        end
        if realChar:FindFirstChild("HumanoidRootPart") then
            realChar.HumanoidRootPart.CanCollide = false
        end
    end
    impersonateRealChar = nil
end
local function startImpersonate(targetName)
    local target = Players:FindFirstChild(targetName)
    if not target or not target.Character then
        WindUI:Notify({Title = "错误", Content = "目标玩家不存在或角色未加载", Type = "error"})
        return
    end
    resetImpersonate()
    task.wait(0.2)
    local targetChar = target.Character
    local realChar = LocalPlayer.Character
    if not realChar then
        WindUI:Notify({Title = "错误", Content = "你的角色未加载", Type = "error"})
        return
    end
    impersonateRealChar = realChar
    targetChar.Archivable = true
    local clone = targetChar:Clone()
    clone.Name = "PossessedClone"
    clone.Parent = workspace
    activeImpersonateClone = clone
    local cloneHum = clone:FindFirstChildOfClass("Humanoid")
    local cloneRoot = clone:FindFirstChild("HumanoidRootPart")
    for _, v in ipairs(clone:GetDescendants()) do
        if v:IsA("SelectionBox") or v:IsA("SelectionSphere") or v:IsA("BoxHandleAdornment") or v:IsA("Highlight") then
            v:Destroy()
        end
    end
    if cloneRoot then cloneRoot.Transparency = 1 end
    if cloneHum then
        cloneHum:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
        cloneHum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        cloneHum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        cloneHum:SetStateEnabled(Enum.HumanoidStateType.Flying, false)
        cloneHum:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
    end
    for _, v in ipairs(clone:GetDescendants()) do
        if v:IsA("BodyMover") or v:IsA("LinearVelocity") or v:IsA("VectorForce") or v:IsA("AlignPosition") or v:IsA("AlignOrientation") or v:IsA("Torque") then
            v:Destroy()
        end
    end
    for _, v in ipairs(realChar:GetDescendants()) do
        if v:IsA("BasePart") or v:IsA("Decal") then v.Transparency = 1 end
        if v:IsA("BasePart") then v.CanCollide = false end
    end
    if realChar:FindFirstChild("HumanoidRootPart") then
        realChar.HumanoidRootPart.CanCollide = false
    end
    LocalPlayer.Character = clone
    Camera.CameraSubject = cloneHum
    local animate = clone:FindFirstChild("Animate")
    if animate then
        animate.Disabled = true
        task.wait(0.1)
        animate.Disabled = false
    end
    local realHum = realChar:FindFirstChildOfClass("Humanoid")
    if realHum then
        realHum.Died:Connect(function() resetImpersonate() end)
    end
    local realHum2 = realChar:FindFirstChildOfClass("Humanoid")
    if realHum2 then realHum2.PlatformStand = true end
    impersonateHeartbeat = RunService.Heartbeat:Connect(function()
        if clone and clone.Parent and cloneRoot and impersonateRealChar and impersonateRealChar:FindFirstChild("HumanoidRootPart") then
            local realRoot = impersonateRealChar.HumanoidRootPart
            realRoot.CFrame = cloneRoot.CFrame
            realRoot.AssemblyLinearVelocity = Vector3.zero
            realRoot.AssemblyAngularVelocity = Vector3.zero
            for _, v in ipairs(impersonateRealChar:GetDescendants()) do
                if v:IsA("BasePart") then
                    if v.CanCollide then v.CanCollide = false end
                    if v.Transparency < 1 then v.Transparency = 1 end
                elseif v:IsA("Decal") and v.Transparency < 1 then
                    v.Transparency = 1
                end
            end
            if cloneHum and cloneHum:GetState() == Enum.HumanoidStateType.Climbing then
                cloneHum:ChangeState(Enum.HumanoidStateType.Running)
            end
        end
    end)
    WindUI:Notify({Title = "成功", Content = "已伪装成: " .. targetName .. "（仅自己可见）", Type = "success"})
end
