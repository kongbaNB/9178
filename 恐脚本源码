local KBLock = { enabled = false, target = nil, conn = nil, range = 1.5, faceTarget = false, sink = false, sinkDepth = 0 }
local function startLock(targetPlayer)
    if KBLock.conn then KBLock.conn:Disconnect() end
    KBLock.target = targetPlayer
    KBLock.enabled = true
    KBLock.conn = RunService.Heartbeat:Connect(function()
        if not KBLock.enabled then return end
        if not KBLock.target then return end
        local tChar = KBLock.target.Character
        if not tChar or not tChar:FindFirstChild("HumanoidRootPart") then return end
        local myChar = LocalPlayer.Character
        if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end
        local myRoot = myChar.HumanoidRootPart
        local tRoot = tChar.HumanoidRootPart
        local myHum = myChar:FindFirstChildOfClass("Humanoid")
        local offset = CFrame.new(0, 0, KBLock.range)
        local goalCF = tRoot.CFrame * offset
        if KBLock.faceTarget then
            goalCF = CFrame.new(goalCF.Position, tRoot.Position)
            if KBLock.sink and KBLock.sinkDepth > 0 then
                goalCF = goalCF * CFrame.Angles(math.rad(25), 0, 0)
            end
        end
        if KBLock.sink and KBLock.sinkDepth > 0 then
            goalCF = CFrame.new(goalCF.Position.X, goalCF.Position.Y - KBLock.sinkDepth, goalCF.Position.Z) * goalCF.Rotation
        end
        if myChar.PrimaryPart then
            myChar:PivotTo(goalCF)
        else
            myRoot.CFrame = goalCF
        end
        if myHum then myHum:ChangeState(Enum.HumanoidStateType.Climbing) end
    end)
    WindUI:Notify({ Title = "锁人", Content = "开始锁定 " .. targetPlayer.Name, Duration = 3 })
end
local function stopLock()
    KBLock.enabled = false
    if KBLock.conn then KBLock.conn:Disconnect() end
    KBLock.conn = nil
    KBLock.target = nil
    local myChar = LocalPlayer.Character
    if myChar then
        local myHum = myChar:FindFirstChildOfClass("Humanoid")
        if myHum then
            myHum:ChangeState(Enum.HumanoidStateType.Running)
        end
    end
    WindUI:Notify({ Title = "锁人", Content = "已停止锁人", Duration = 3 })
end
