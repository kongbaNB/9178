function kbBypassFly.RefreshParts()
    local char = player.Character
    if not char then
        kbBypassFly.State.hrp = nil
        kbBypassFly.State.hum = nil
        kbBypassFly.Anchor.hrp = nil
        kbBypassFly.Anchor.head = nil
        kbBypassFly.Anchor.hum = nil
        return
    end
    kbBypassFly.State.hrp = char:FindFirstChild("HumanoidRootPart")
    kbBypassFly.State.hum = char:FindFirstChildOfClass("Humanoid")
    kbBypassFly.Anchor.hrp = kbBypassFly.State.hrp
    kbBypassFly.Anchor.head = char:FindFirstChild("Head")
    kbBypassFly.Anchor.hum = kbBypassFly.State.hum
end
function kbBypassFly.DetectWall()
    local hrp = kbBypassFly.Anchor.hrp
    if not hrp then return false end
    local pos = hrp.Position
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = { player.Character }
    for i = 1, kbBypassFly.Anchor.rayCount do
        local angle = (i / kbBypassFly.Anchor.rayCount) * 2 * math.pi
        local dx = math.cos(angle)
        local dz = math.sin(angle)
        for j = -(kbBypassFly.Anchor.verticalLayers - 1) // 2, (kbBypassFly.Anchor.verticalLayers - 1) // 2 do
            local dir = Vector3.new(dx, j * 0.5, dz).Unit
            local result = workspace:Raycast(pos, dir * kbBypassFly.Anchor.rayLength, params)
            if result and result.Instance and result.Instance.CanCollide and result.Instance.Transparency < 0.9 then
                return true
            end
        end
    end
    return false
end
function kbBypassFly.EnterAnchor()
    if kbBypassFly.Anchor.active then return end
    if not kbBypassFly.Anchor.head or not kbBypassFly.Anchor.hrp or not kbBypassFly.Anchor.hum then return end
    kbBypassFly.Anchor.head.Anchored = true
    kbBypassFly.Anchor.hum.PlatformStand = true
    kbBypassFly.Anchor.active = true
end
function kbBypassFly.ExitAnchor()
    if not kbBypassFly.Anchor.active then return end
    if kbBypassFly.Anchor.head and kbBypassFly.Anchor.hum then
        kbBypassFly.Anchor.head.Anchored = false
        kbBypassFly.Anchor.hum.PlatformStand = false
    end
    kbBypassFly.Anchor.active = false
end
function kbBypassFly.MicroStepLoop()
    kbBypassFly.State.targetPos = kbBypassFly.State.hrp.Position
    kbBypassFly.State.lastTime = tick()
    while kbBypassFly.State.enabled do
        local now = tick()
        local dt = now - kbBypassFly.State.lastTime
        kbBypassFly.State.lastTime = now
        if not kbBypassFly.State.hrp or not kbBypassFly.State.hrp.Parent then break end
        local inWall = kbBypassFly.DetectWall()
        if inWall and not kbBypassFly.Anchor.active then
            kbBypassFly.EnterAnchor()
        elseif not inWall and kbBypassFly.Anchor.active then
            kbBypassFly.ExitAnchor()
        end
        local moveDir
        if kbBypassFly.Control then
            local mv = kbBypassFly.Control:GetMoveVector()
            local cf = workspace.CurrentCamera.CFrame
            moveDir = (cf.LookVector * -mv.Z) + (cf.RightVector * mv.X)
        else
            moveDir = (kbBypassFly.State.hum and kbBypassFly.State.hum.MoveDirection) or Vector3.zero
        end
        local vertical = 0
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            vertical = 1
        elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            vertical = -1
        end
        local delta = (moveDir + Vector3.new(0, vertical, 0)) * kbBypassFly.Speed * dt
        kbBypassFly.State.targetPos = kbBypassFly.State.targetPos + delta
        local currentPos = kbBypassFly.State.hrp.Position
        local remaining = kbBypassFly.State.targetPos - currentPos
        local distance = remaining.Magnitude
        if distance > 0 then
            local steps = math.ceil(distance / 10)
            local stepVec = remaining / steps
            for i = 1, steps do
                if not kbBypassFly.State.enabled then break end
                currentPos = currentPos + stepVec
                kbBypassFly.State.hrp.CFrame = CFrame.new(currentPos) * kbBypassFly.State.hrp.CFrame.Rotation
                kbBypassFly.State.hrp.Velocity = Vector3.zero
            end
        else
            kbBypassFly.State.hrp.CFrame = CFrame.new(kbBypassFly.State.targetPos) * kbBypassFly.State.hrp.CFrame.Rotation
            kbBypassFly.State.hrp.Velocity = Vector3.zero
        end
        if kbBypassFly.State.hum then
            kbBypassFly.State.hum:ChangeState(Enum.HumanoidStateType.Climbing)
        end
        task.wait(0.001)
    end
end
function kbBypassFly.HealthLockLoop()
    while kbBypassFly.State.enabled do
        if kbBypassFly.State.hum and kbBypassFly.State.hum.Health <= 0 then
            kbBypassFly.State.hum.Health = kbBypassFly.State.hum.MaxHealth
        end
        task.wait(0.1)
    end
end
function kbBypassFly.Start()
    if kbBypassFly.State.enabled then return end
    kbBypassFly.RefreshParts()
    if not kbBypassFly.State.hrp or not kbBypassFly.State.hum then return end
    kbBypassFly.State.enabled = true
    kbBypassFly.State.hum:ChangeState(Enum.HumanoidStateType.Climbing)
    kbBypassFly.State.microThread = task.spawn(kbBypassFly.MicroStepLoop)
    kbBypassFly.State.healthThread = task.spawn(kbBypassFly.HealthLockLoop)
    kbBypassFly.State.diedConn = kbBypassFly.State.hum.Died:Connect(function()
        if kbBypassFly.State.hum and kbBypassFly.State.enabled then
            kbBypassFly.State.hum.Health = kbBypassFly.State.hum.MaxHealth
            kbBypassFly.State.hum:ChangeState(Enum.HumanoidStateType.Running)
        end
    end)
end
function kbBypassFly.Stop()
    kbBypassFly.State.enabled = false
    kbBypassFly.ExitAnchor()
    if kbBypassFly.State.microThread then pcall(function() task.cancel(kbBypassFly.State.microThread) end) kbBypassFly.State.microThread = nil end
    if kbBypassFly.State.healthThread then pcall(function() task.cancel(kbBypassFly.State.healthThread) end) kbBypassFly.State.healthThread = nil end
    if kbBypassFly.State.diedConn then kbBypassFly.State.diedConn:Disconnect() kbBypassFly.State.diedConn = nil end
    if kbBypassFly.State.hum then kbBypassFly.State.hum:ChangeState(Enum.HumanoidStateType.Running) end
end
